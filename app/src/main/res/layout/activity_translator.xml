<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEURAL UPLINK"
                    android:textColor="#888"
                    android:textSize="11sp"
                    android:letterSpacing="0.2" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TERMINAL OMEGA-7"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCONNECTED"
                android:textColor="#888"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Mapped state -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COGNITIVE TRANSLATION"
            android:textColor="#888"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tMapped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="@color/connected"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Signal + Attention -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Signal Quality"
                        android:textColor="#aaa"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tSignalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/tSignalBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Attention eSense"
                        android:textColor="#aaa"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tAttText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/connected"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/tAttBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Raw value -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ASIC Raw Value"
                android:textColor="#888"
                android:textSize="11sp"
                android:letterSpacing="0.15" />
            <TextView
                android:id="@+id/tRaw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Wave bands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPECTRAL FREQUENCY ANALYSIS"
            android:textColor="#888"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp" />

        <include
            android:id="@+id/tDeltaRow"
            layout="@layout/wave_row"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/tThetaRow"
            layout="@layout/wave_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/tAlphaRow"
            layout="@layout/wave_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/tBetaRow"
            layout="@layout/wave_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/tGammaRow"
            layout="@layout/wave_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Terminal log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TERMINAL OUTPUT"
            android:textColor="#888"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp" />

        <ScrollView
            android:id="@+id/tLogScroll"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="#FF000000"
            android:padding="12dp">
            <TextView
                android:id="@+id/tLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:text="" />
        </ScrollView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tConnectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="Connect Hardware" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tRecBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start Logging"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tExportBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export CSV"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
